class Demo {
    public int a = 10;
    private int b = 20;

    void show() {
        System.out.println(a);
        System.out.println(b);
    }
}

public class Main {
    public static void main(String[] args) {
        Demo d = new Demo();
        d.show();

        System.out.println(d.a);
        // System.out.println(d.b); // ERROR (private)
    }
}
