public class Main {
    public static void main(String[] args) {
        int a = 5;
        int b = 0;

        System.out.println("Before division");

        // Debugging example (avoid crash)
        if (b != 0) {
            System.out.println(a / b);
        } else {
            System.out.println("Cannot divide by zero");
        }

        System.out.println("After division");
    }
}
