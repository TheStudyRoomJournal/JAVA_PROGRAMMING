// Description:
// Demonstrates Java Streams API.

// Key Notes:
// - Used for collection processing

import java.util.*;

public class StreamsAPIDemo {

    public static void main(String[] args) {

        List<Integer> list =
            Arrays.asList(1,2,3,4,5);

        list.stream()
            .filter(n -> n % 2 == 0)
            .forEach(System.out::println);
    }
}
