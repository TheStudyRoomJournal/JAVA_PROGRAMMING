// Description:
// Demonstrates Optional class.

// Key Notes:
// - Avoids NullPointerException

import java.util.Optional;

public class OptionalClassDemo {

    public static void main(String[] args) {

        Optional<String> name =
            Optional.ofNullable(null);

        System.out.println(
            name.orElse("Default")
        );
    }
}
