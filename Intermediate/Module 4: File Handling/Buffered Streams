// Description:
// Demonstrates buffered reading.

// Key Notes:
// - Improves file I/O performance

import java.io.*;

public class BufferedStreams {

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(
                new FileReader("test.txt")
            );

        System.out.println(br.readLine());

        br.close();
    }
}
