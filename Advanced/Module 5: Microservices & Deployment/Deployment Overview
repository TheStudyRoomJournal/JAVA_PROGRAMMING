/*
Description:
Simulates deployment process steps.

Key Concepts:
- Build
- Test
- Deploy
*/

public class DeploymentOverview {

    static void build() {
        System.out.println("Building Application...");
    }

    static void test() {
        System.out.println("Running Tests...");
    }

    static void deploy() {
        System.out.println("Deploying to Server...");
    }

    public static void main(String[] args) {

        build();

        test();

        deploy();

        System.out.println("Deployment Successful");
    }
}
