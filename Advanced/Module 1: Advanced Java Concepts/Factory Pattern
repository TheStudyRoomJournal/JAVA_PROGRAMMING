// Description:
// Demonstrates Factory Design Pattern.

// Key Notes:
// - Object creation delegated to factory class

interface Animal {
    void sound();
}

class Dog implements Animal {
    public void sound() {
        System.out.println("Bark");
    }
}

class AnimalFactory {

    Animal getAnimal() {
        return new Dog();
    }
}

public class FactoryPattern {

    public static void main(String[] args) {

        AnimalFactory f = new AnimalFactory();

        Animal a = f.getAnimal();

        a.sound();
    }
}
