/*
Description:
Demonstrates JUnit unit testing.

Requirements:
- JUnit dependency
*/

import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.*;

class Calculator {

    int add(int a, int b) {
        return a + b;
    }
}

public class JUnitTestingDemo {

    Calculator c = new Calculator();

    @Test
    void testAddition() {

        assertEquals(10, c.add(5, 5));
    }
}
